# Base url of your Lavalink node, no trailing slash. Example: https://node.example.com
LAVALINK_URL=
# The password from application.yml (lavalink.server.password)
LAVALINK_PASSWORD=
# Optional override. Normally leave this empty: the bot commits its current
# session id to session.json, and the api reads it from there.
LAVALINK_SESSION_ID=
