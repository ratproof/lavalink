# Base url of your Lavalink node, no trailing slash. Example: https://node.example.com
LAVALINK_URL=
# The password from application.yml (lavalink.server.password)
LAVALINK_PASSWORD=
# Optional. Session id of your bot's Lavalink websocket session.
# Set it to list active players. Leave empty to only show totals.
LAVALINK_SESSION_ID=
